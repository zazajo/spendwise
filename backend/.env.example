# Copy this file to .env and fill in real values for your machine.
# .env is gitignored on purpose — never commit actual secrets.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=True

# Comma-separated list, e.g. localhost,127.0.0.1,your-lan-ip
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset in development — CORS_ALLOW_ALL_ORIGINS defaults to whatever
# DEBUG is set to. Set a comma-separated origin list here for production.
# CORS_ALLOWED_ORIGINS=https://app.example.com
