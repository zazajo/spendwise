# Copy to .env for local overrides. Expo inlines EXPO_PUBLIC_ vars at build time.
# Leave unset to auto-derive the API URL from the Metro dev server's LAN IP
# (see src/constants/config.ts) - convenient for physical devices during dev.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# "Sign in with Google" - Web application OAuth client ID from
# https://console.cloud.google.com/apis/credentials. Safe to expose to the
# client; it's not a secret (see src/services/google-auth.ts).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Stable HTTPS page that relays Google's redirect back into the app (Google
# rejects custom-scheme redirect URIs for Web client IDs, so this has to be a
# real https:// page you host - see mobile/auth-relay/index.html).
EXPO_PUBLIC_GOOGLE_RELAY_URL=
